APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# 正式站一律 true(全站 HTTPS);本機開發若走 http 才設 false
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── 廣告設定 ─────────────────────────────────────
# adapter: exoclick（成人站首選）| trafficjunky | adsense（成人內容不可用，僅保留）
AD_ADAPTER=exoclick

# /ads.txt 內容，多行用 | 分隔（各聯播網後台會提供你的 publisher 行）
# 例：ADS_TXT_LINES="exoclick.com, 123456, DIRECT"
ADS_TXT_LINES=

# ── ExoClick（成人網站，申請最容易）────────────────
# exoclick.com 註冊 Publisher → Sites & Zones 建立網站與各版位 zone。
# zone 尺寸是固定的，所以窄／寬各要一個 zone：基準值用 300x250（手機與平板），
# _DESKTOP 是滿版容器在寬螢幕用的大尺寸（本站用 900x250），可留空。
# 彈窗（game_end）在對話框裡，容器就是窄的，不需要 _DESKTOP。
EXOCLICK_ZONE_HOME_BANNER=
EXOCLICK_ZONE_HOME_BANNER_DESKTOP=
EXOCLICK_ZONE_HOME_MID=
EXOCLICK_ZONE_HOME_MID_DESKTOP=
EXOCLICK_ZONE_LOBBY_SIDE=
EXOCLICK_ZONE_LOBBY_SIDE_DESKTOP=
EXOCLICK_ZONE_GAME_END=
EXOCLICK_ZONE_GAME_END_VAST=
EXOCLICK_ZONE_SHARE=
EXOCLICK_ZONE_SHARE_DESKTOP=

# ── TrafficJunky（成人網站，大流量後再申請）─────────
TRAFFICJUNKY_SITE_ID=
TRAFFICJUNKY_SPOT_HOME_BANNER=
TRAFFICJUNKY_SPOT_HOME_MID=
TRAFFICJUNKY_SPOT_LOBBY_SIDE=
TRAFFICJUNKY_SPOT_GAME_END=
TRAFFICJUNKY_SPOT_SHARE=

# ── Google AdSense（本站內容不符其政策，勿對成人內容啟用）──
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_HOME_BANNER=
ADSENSE_SLOT_HOME_MID=
ADSENSE_SLOT_LOBBY_SIDE=
ADSENSE_SLOT_GAME_END=
ADSENSE_SLOT_SHARE=

# Google Analytics 4
GOOGLE_GA4_ID=

# 客服聯絡方式(顯示在 Premium 頁;留空則不顯示該項)
SUPPORT_EMAIL=
SUPPORT_LINE=

# 測試版公告(右下角小卡／手機底部細條)。正式上線設 false 就整塊消失。
# 版號 +1 會讓已經關掉的人重新看到一次,用來宣布下一件事。
BETA_NOTICE=true
BETA_NOTICE_VERSION=1
